rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a signed-in account whose email is on the allowlist.
    // Keep this list in sync with storage.rules and ADMIN_EMAILS in functions/index.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kirti.vetaas@gmail.com', 'skandaumesh82@gmail.com'];
    }

    // Events: anyone can view; only an admin can manage them
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Membership orders: created only by the createMembershipOrder Cloud
    // Function (Admin SDK, bypasses these rules) so the charged amount is
    // always computed server-side. No client write path at all.
    match /membershipOrders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Cart orders: written only by createCartOrder (Admin SDK, bypasses these
    // rules) so the charged amount is always recomputed from the server-side
    // catalog. No client write path at all.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Quiz submissions: a visitor may only file a new, well-formed result;
    // a Cloud Function emails the score. Only an admin can read them back.
    match /quizSubmissions/{subId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'quizId', 'quizName', 'name', 'email', 'score', 'maxScore', 'percentage',
             'band', 'bandBlurb', 'sections', 'answers', 'createdAt'])
        && request.resource.data.quizId in ['sel-assessment', 'parent-reflection']
        && request.resource.data.quizName is string
        && request.resource.data.quizName.size() < 100
        && (!('band' in request.resource.data)
          || (request.resource.data.band is string && request.resource.data.band.size() < 100))
        && (!('bandBlurb' in request.resource.data)
          || (request.resource.data.bandBlurb is string && request.resource.data.bandBlurb.size() < 400))
        && (!('sections' in request.resource.data)
          || (request.resource.data.sections is list && request.resource.data.sections.size() <= 10))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.email.size() < 200
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // Email queue: only an admin can enqueue; the sending Cloud Function uses
    // the Admin SDK and bypasses these rules
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    // True when the admin entered their password in the last 5 minutes. The
    // admin panel re-asks for it before deleting, which refreshes auth_time.
    function recentlySignedIn() {
      return request.time.toMillis() - request.auth.token.auth_time * 1000 < 5 * 60 * 1000;
    }

    // Forms: the public fill page needs to read a form's definition to render
    // it; only an admin can create or edit forms. Deleting also needs a fresh
    // password entry, so a session left signed in on a shared device — or a
    // delete sent from the dev console — can't remove forms without it.
    match /forms/{formId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && recentlySignedIn();
    }

    // Form responses: anyone may file a new, well-formed response to a FREE
    // form; only an admin can read them back.
    //
    // Paid registrations never come through here — the createEventRegistration
    // Cloud Function writes them with the Admin SDK, which bypasses these
    // rules, so the charged amount is always the one stored on the form. Two
    // guards keep that airtight: the form being written to must be free, and
    // the payment fields may not appear in a client-written document (so a
    // free response can't be forged to look paid).
    match /formResponses/{responseId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['formId', 'formTitle', 'answers', 'ticketToken', 'createdAt'])
        && request.resource.data.formId is string
        && request.resource.data.formId.size() < 60
        && request.resource.data.formTitle is string
        && request.resource.data.formTitle.size() < 200
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 50
        && !('paymentStatus' in request.resource.data)
        && !('amount' in request.resource.data)
        && !('razorpayOrderId' in request.resource.data)
        && !('razorpayPaymentId' in request.resource.data)
        && !('checkedInAt' in request.resource.data)
        && !('confirmationSentAt' in request.resource.data)
        && !('payerEmail' in request.resource.data)
        // Optional ticket token the visitor generates so their ticket link can
        // be shown straight away; the ticket itself is issued server-side.
        && (!('ticketToken' in request.resource.data)
          || (request.resource.data.ticketToken is string
            && request.resource.data.ticketToken.matches('^[a-f0-9]{64}$')))
        && get(/databases/$(database)/documents/forms/$(request.resource.data.formId))
             .data.get('price', 0) == 0
        // A closed form takes no more registrations, even written directly.
        && get(/databases/$(database)/documents/forms/$(request.resource.data.formId))
             .data.get('status', 'open') == 'open';
      allow read, update, delete: if isAdmin();
    }

    // Abuse-limit counters (see withinLimit in functions/index.js). Only the
    // Cloud Functions touch these; the catch-all below already denies the
    // browser, this just says so where someone will look.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Event tickets. The document id is a 256-bit random token, so a ticket
    // can only be opened with the exact link from the registrant's email — it
    // can't be listed or guessed. Only Cloud Functions create them; an admin
    // may only change the check-in time.
    match /tickets/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedInAt']);
      allow create, delete: if false;
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
