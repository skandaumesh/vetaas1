rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a signed-in account whose email is on the allowlist.
    // Keep this list in sync with src/lib/admin.ts and storage.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kirti.vetaas@gmail.com'];
    }

    // Events: anyone can view; only an admin can manage them
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Membership orders: created only by the createMembershipOrder Cloud
    // Function (Admin SDK, bypasses these rules) so the charged amount is
    // always computed server-side. No client write path at all.
    match /membershipOrders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Quiz submissions: a visitor may only file a new, well-formed result;
    // a Cloud Function emails the score. Only an admin can read them back.
    match /quizSubmissions/{subId} {
      allow create: if request.auth != null
        && request.resource.data.quizId is string
        && request.resource.data.quizId.size() < 60
        && request.resource.data.quizName is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.email.size() < 200
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // Email queue: only an admin can enqueue; the sending Cloud Function uses
    // the Admin SDK and bypasses these rules
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    // Forms: the public fill page needs to read a form's definition to render
    // it; only an admin can create/edit/delete forms.
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Form responses: anyone may file a new, well-formed response to a form;
    // only an admin can read them back.
    match /formResponses/{responseId} {
      allow create: if request.auth != null
        && request.resource.data.formId is string
        && request.resource.data.formId.size() < 60
        && request.resource.data.formTitle is string
        && request.resource.data.formTitle.size() < 200
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 50;
      allow read, update, delete: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
