rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin = a signed-in account whose email is on the allowlist.
    // Keep this list in sync with src/lib/admin.ts and firestore.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kirti.vetaas@gmail.com'];
    }

    // Paid downloads. Never readable through these rules — after payment a
    // Cloud Function mints a signed (or tokenised) link with the Admin SDK,
    // which bypasses rules. A catch-all public read would have made every
    // worksheet downloadable by anyone who guessed the path.
    match /products/{file=**} {
      allow read, write: if isAdmin();
    }

    // Event posters and form cover images are public content. They're served
    // through download-token URLs, so this read rule only matters for the SDK
    // calls that mint those URLs.
    match /eventImages/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /formLogos/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Form upload answers: a visitor filling out a public form may upload an
    // image or common document under 10 MB. Types are an explicit allowlist —
    // no executables, archives or HTML, which could be served back to someone.
    // Nobody but an admin can read them back: the response stores the storage
    // path, not a download link, and the admin panel resolves it when viewing.
    // (Older responses hold tokenised download URLs, which keep working.)
    match /formUploads/{formId}/{file} {
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|gif|webp|heic|heif)')
          || request.resource.contentType in [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-excel',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
            'application/vnd.ms-powerpoint',
            'application/vnd.openxmlformats-officedocument.presentationml.presentation',
            'text/plain',
            'text/csv'
          ]);
      allow read: if isAdmin();
    }

    // Legacy payment screenshots from before Razorpay.
    match /membership-screenshots/{file} {
      allow create: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isAdmin();
    }

    // Anything else is admin-only, so a new bucket path is private by default
    // rather than world-readable.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
